# Cloudflare Pages 응답 헤더
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow

# 해시가 붙은 빌드 산출물: 장기 캐시
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 설정 파일: 교체 즉시 반영
/config/*
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
